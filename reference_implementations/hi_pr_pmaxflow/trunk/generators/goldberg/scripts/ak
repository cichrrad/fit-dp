#!/bin/sh

# directories
codebin=${codebin-../bin/}
genbin=${genbin-../bin/}
results=${results-../results/}

# parameters
numruns=${numruns-1}

gen=${genbin}ak
suffix=`basename $0`

for prog in $*
do
  outfile=${results}${prog}.$suffix

  # remove output from last time
  rm -f ${outfile}

  # print identifying information to output file
  echo "c $prog.$suffix generated by $USER@`hostname` on `date`"  >> ${outfile}
  echo -n "c " >> ${outfile}
  ls -l ${gen} >> ${outfile}
  echo -n "c md5sum: " >> ${outfile}
  md5sum ${gen} >> ${outfile}
  echo -n "c " >> ${outfile}
  ls -l ${codebin}${prog} >> ${outfile}
  echo -n "c md5sum: " >> ${outfile}
  md5sum ${codebin}${prog} >> ${outfile}
  echo " " >> ${outfile}

  # loop over all parameters
  gensetting=1
  for par in 1024 2048 4096 8192 16384 32768
  do
    # loop over number of runs
    run=1
    while [ $run -le $numruns ]
    do
      echo "
c Gen Setting #: " $gensetting " Seed #:" $sd " Run #:" $run >> ${outfile}
      echo "${gen} ${par} |${codebin}${prog} >>${outfile}"
      ${gen} ${par} | ${codebin}${prog} >> ${outfile}
      run=`expr $run + 1`
    done
    gensetting=`expr $gensetting + 1`
  done
done